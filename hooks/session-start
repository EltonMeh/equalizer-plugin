#!/usr/bin/env bash
# SessionStart hook for Equalizer plugin

set -euo pipefail

# Lightweight session context — full skill is loaded on-demand via the skill system
context="The Equalizer analytics plugin is installed. Use the equalizer-analytics skill when users ask about Equalizer data, stratification views, or transaction analytics. Use the spv-discovery skill when users want to explore available SPVs, browse asset classes, or understand what analytics are available."

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$context"
